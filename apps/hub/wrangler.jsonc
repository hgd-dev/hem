{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hem-hub",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hem",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GAME_CLIENT_URL": "https://hem-client.REPLACE.workers.dev/",
    "PROXY_URL": "https://play.REPLACE.example",
    "GAME_DESTINATION_HOST": "orchestrator",
    "ORCHESTRATOR_URL": "https://play-api.REPLACE.example"
  }
}
