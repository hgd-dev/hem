# DNS for these two names must point to the VPS running docker compose.
PLAY_DOMAIN=play.example.com
CONTROL_DOMAIN=control.example.com

# Public HEM browser-client origin, used as the WebSocket proxy CORS allowlist.
CLIENT_ORIGIN=https://client.example.workers.dev
# Public Cloudflare HEM hub Worker URL. Paper calls this to consume launch tokens.
HEM_HUB_URL=https://hem.example.workers.dev

# Generate each with: openssl rand -hex 32
ORCHESTRATOR_KEY=replace-me
SERVER_SERVICE_KEY=replace-me-too

MAX_ACTIVE_WORLDS=2
WORLD_XMS=512M
WORLD_XMX=3G
IDLE_STOP_MINUTES=15

# Set TRUE only after you have reviewed and accepted https://aka.ms/MinecraftEULA
ACCEPT_MINECRAFT_EULA=FALSE
